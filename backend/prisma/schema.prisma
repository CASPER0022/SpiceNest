// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// Our Database Tables (Models)
// ==========================================

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  price       Float
  category    String
  images      String[]
  isArchived  Boolean  @default(false)
  stock       Float    @default(10.0)
  story       String?
  
  
  // Relation to Farmer
  farmerId    Int?
  farmer      Farmer?  @relation(fields: [farmerId], references: [id])
  
  // These automatically keep track of when a product was added/updated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  address          String?
  role             String    @default("USER")
  resetToken       String?   @unique   // SHA-256 hash of the emailed token
  resetTokenExpiry DateTime?
  // Embedded in every JWT; bumping it (e.g. on password reset) revokes all existing sessions.
  tokenVersion     Int       @default(0)

  // Email verification. Default is true ONLY so that accounts that already exist when this
  // column is added are grandfathered in. The register route always sets it to false explicitly.
  emailVerified     Boolean   @default(true)
  emailVerifyToken  String?   @unique   // SHA-256 hash of the emailed token
  emailVerifyExpiry DateTime?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  orders           Order[]
  cartItems        CartItem[]
  reviews          Review[]
  wishlist         WishlistItem[]
}

model Order {
  id              Int            @id @default(autoincrement())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  totalAmount     Float
  address         String         // Snapshot of address as JSON string
  status          String         @default("PAID")
  stripeSessionId   String?        @unique
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  // Random secret emailed to the customer; lets them track the order without guessing IDs.
  trackingToken   String?        @unique
  items           OrderItem[]
  messages        OrderMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id])
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String?
  productImage String?
  quantity     Int
  price     Float
  weight    String
  initialStock Float?
  finalStock   Float?
}

model Farmer {
  id        Int       @id @default(autoincrement())
  name      String
  rating    Float
  about     String
  image     String
  products  Product[]
  reviews   Review[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderMessage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  sentBy    String   // e.g. "admin"
  createdAt DateTime @default(now())
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  weight    String   @default("100g")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, weight])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1 to 5 stars
  comment   String   @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  farmerId  Int?
  farmer    Farmer?  @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@unique([userId, farmerId])
}

// Server-side record of a checkout, written when the payment order/session is created.
// Confirmation reads the buyer, address and cart from here, never from the client.
model PendingCheckout {
  id         String   @id          // Razorpay order ID or Stripe Checkout Session ID
  provider   String                // "razorpay" | "stripe"
  userId     String?               // from the JWT at checkout time; null = guest
  address    String                // sanitized address JSON (with clientIp)
  items      Json                  // [{ id, weight, quantity }]
  couponCode String   @default("")
  createdAt  DateTime @default(now())

  // Stock held for this checkout until it is paid or reservedUntil passes (then released).
  reserved      Boolean   @default(false)
  reservation   Json?                 // per cart line: { productId, weight, kg, initialStock, finalStock }
  reservedUntil DateTime?

  @@index([createdAt])
  @@index([reserved, reservedUntil])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}


